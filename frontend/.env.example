# Optional override for the backend URL in static builds.
# When left blank:
# - Static serving (`python -m http.server 5500 -d dashboard`) defaults to http://127.0.0.1:8000
# - Vite dev/preview (`npm run dev` on :5173) uses same-origin proxy to SIMULATE_TARGET
VITE_SIMULATE_URL=

# Server-side proxy target for `npm run dev`.
SIMULATE_TARGET=http://127.0.0.1:8000
